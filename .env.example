# Copy to .env. Every setting here is optional: the app runs with an empty file,
# and the AI assistant is configured from the UI (Settings -> AI Provider).

# ---- Server ----
# "production" turns on the Secure cookie flag, so it needs HTTPS in front of
# it. Leave this on development for the usual http://localhost run.
APP_ENV=development
# Optional. Left empty, the app mints a random key each time it starts, which
# only means a restart forgets sessions — the uploaded chat is in memory and
# does not survive one either. Set it to a random string to keep sessions
# across restarts. APP_ENV=production refuses to start on a placeholder.
FLASK_SECRET=
LOG_LEVEL=INFO
# Werkzeug's interactive debugger executes code submitted through the browser.
# It is off in every environment unless this is switched on deliberately; the
# auto-reloader does not depend on it and stays on in development.
ENABLE_DEBUGGER=0
SESSION_LIFETIME_DAYS=7
PORT=8000

# ---- Cloud AI (Groq) ----
# Optional. Leave it empty and each user pastes their own key into Settings; it
# is held in their browser session on the server and never written to disk.
# Free keys: https://console.groq.com/keys
GROQ_API_KEY=

# A preference, not a requirement: the assistant lists what Groq serves for
# your key and falls back if this one is no longer available.
GROQ_MODEL=llama-3.1-8b-instant
# Which models the picker offers, in the order it lists them. Groq serves a
# couple of dozen; these are the ones worth pointing at a short, statistics-
# grounded question. Empty offers every chat model Groq serves for your key.
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_MAX_TOKENS=800
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT=30
GROQ_REASONING_EFFORT=low
GROQ_REASONING_FORMAT=hidden

# ---- Assistant limits ----
# A burst cap only. There is no daily quota: the key belongs to the user, so
# Groq already meters what their questions cost them.
AI_RATE_PER_MIN=10
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_CONTEXT_CHARS=4000
AI_HISTORY_TURNS=6

# ---- Local AI (optional) ----
# Message analysis against a model running on this computer. "auto" probes
# LM Studio (:1234) then Ollama (:11434) and uses whichever answers first.
LOCAL_LLM_PROVIDER=auto
# Only set this to pin one endpoint. It must stay on loopback: raw WhatsApp
# excerpts never leave this machine, and that restriction is enforced at start.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Leave empty to pick from the loaded models in the assistant's Local menu.
LOCAL_LLM_MODEL=
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_MESSAGES=50
LOCAL_LLM_MAX_MESSAGE_CHARS=300
LOCAL_LLM_MAX_TOKENS=500
LOCAL_LLM_TIMEOUT=60
# LM Studio only. Stops a reasoning model spending the reply budget thinking.
LOCAL_LLM_REASONING_EFFORT=none
